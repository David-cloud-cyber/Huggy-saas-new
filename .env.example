# GEMINI_API_KEY: Required for Gemini AI API calls.
# Huggy automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the Huggy UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Huggy automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter Configuration
# Recommended Railway variable name: OPENROUTER_API_KEY.
# Accepted aliases: OPEN_ROUTER_API_KEY, OPENROUTER_KEY, OPENROUTER_TOKEN.
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="https://huggy.app"
OPENROUTER_APP_NAME="Huggy SaaS"

# AI Policy Configuration
AI_ALLOWED_MODELS="google/gemini-3-flash-preview,google/gemini-3.5-flash,openai/gpt-5-mini,google/gemini-3-pro-preview,anthropic/claude-sonnet-4.6,anthropic/claude-opus-4.7,openai/gpt-5.5,openai/gpt-5.5-pro,deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,anthropic/claude-opus-4.8,anthropic/claude-opus-4.8-fast"
AI_STRICT_MODEL_ALLOWLIST=true
AI_DISABLE_UNLISTED_FALLBACKS=true

# Supabase Configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase Google Auth setup
# Enable Google in Supabase Auth Providers and add the Google OAuth Client ID/Secret there.
# Add these Supabase Auth Redirect URLs:
# - https://www.huggy.fun/auth.html
# - https://www.huggy.fun/auth.html?redirect=/dashboard.html
# - http://localhost:3000/auth.html
# Google Cloud Authorized JavaScript origins should include:
# - https://www.huggy.fun
# - http://localhost:3000
# Google Cloud Authorized redirect URI must be the Supabase callback, for example:
# - https://<project-ref>.supabase.co/auth/v1/callback
