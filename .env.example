# GEMINI_API_KEY: Required for Gemini AI API calls.
# Huggy automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the Huggy UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Huggy automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter Configuration
OPENROUTER_API_KEY=""
OPENROUTER_SITE_URL="https://huggy.app"
OPENROUTER_APP_NAME="Huggy SaaS"

# AI Policy Configuration
AI_ALLOWED_MODELS="anthropic/claude-opus-4.8,anthropic/claude-opus-4.8-fast,anthropic/claude-sonnet-4-5,anthropic/claude-haiku-4-5,openai/gpt-4o,openai/gpt-4o-mini,openai/o3,openai/o4-mini,google/gemini-2.5-pro,google/gemini-2.5-flash,google/gemini-2.0-flash-exp,meta-llama/llama-4-maverick,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2411,mistralai/mistral-medium-3,mistralai/codestral-2501,x-ai/grok-3,x-ai/grok-3-mini,deepseek/deepseek-r2,deepseek/deepseek-chat-v3-0324"
AI_STRICT_MODEL_ALLOWLIST=true
AI_DISABLE_UNLISTED_FALLBACKS=true

# Supabase Configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
